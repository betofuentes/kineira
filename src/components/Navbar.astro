---
const links = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Sobre Iris', href: '#sobre-iris' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Blog', href: '#blog' },
  { label: 'Contacto', href: '#contacto' },
];
---

<header
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-crema/80 backdrop-blur-md"
>
  <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#inicio" class="flex-shrink-0">
      <img
        src="/assets/logo-horizontal.png"
        alt="Kineira - Fisioterapia Pediátrica"
        class="h-10 w-auto"
      />
    </a>

    <!-- Desktop links -->
    <ul class="hidden md:flex items-center gap-8">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-texto-suave hover:text-texto font-medium transition-colors duration-200 text-sm"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="https://wa.me/1234567890?text=Hola%20Iris%2C%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20Kineira"
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex items-center gap-2 bg-amarillo hover:bg-amarillo/80 text-texto font-bold text-sm px-5 py-2.5 rounded-full transition-all duration-200 shadow-sm hover:shadow-md"
    >
      Agendar cita
    </a>

    <!-- Mobile menu button -->
    <button
      id="menu-toggle"
      class="md:hidden p-2 rounded-lg hover:bg-amarillo/20 transition-colors"
      aria-label="Abrir menú"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-crema border-t border-amarillo/30 px-6 py-4"
  >
    <ul class="flex flex-col gap-4 mb-4">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class="mobile-link block text-texto-suave hover:text-texto font-medium transition-colors"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="https://wa.me/1234567890?text=Hola%20Iris%2C%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20Kineira"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 bg-amarillo text-texto font-bold text-sm px-5 py-2.5 rounded-full w-full justify-center"
    >
      Agendar cita
    </a>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
    });
  });
</script>
