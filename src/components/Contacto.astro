---
---

<section id="contacto" class="py-24 bg-white relative overflow-hidden">
  <div class="absolute top-0 left-0 w-80 h-80 bg-azul/10 rounded-full blur-3xl pointer-events-none -translate-x-20 -translate-y-20"></div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-16 items-center">
      <!-- Info -->
      <div>
        <span class="inline-block bg-azul/20 text-texto font-semibold text-sm px-4 py-1.5 rounded-full mb-6">
          Contacto
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-texto mb-6">
          ¡Hablemos!<br />Primera consulta sin costo
        </h2>
        <p class="text-texto-suave leading-relaxed mb-10">
          Cuéntanos sobre tu hijo y sus necesidades. Respondemos en menos de 24 horas y la primera consulta orientativa es completamente gratuita.
        </p>

        <div class="flex flex-col gap-6">
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-amarillo/30 rounded-2xl flex items-center justify-center text-xl flex-shrink-0">
              📍
            </div>
            <div>
              <p class="font-bold text-texto">Ubicación</p>
              <p class="text-texto-suave text-sm mt-1">Dirección del consultorio, Ciudad<br />Consultas presenciales y orientación en línea</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-azul/20 rounded-2xl flex items-center justify-center text-xl flex-shrink-0">
              🕐
            </div>
            <div>
              <p class="font-bold text-texto">Horarios</p>
              <p class="text-texto-suave text-sm mt-1">Lunes a viernes: 8:00 – 17:00<br />Sábados: 9:00 – 13:00</p>
            </div>
          </div>

          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-coral/20 rounded-2xl flex items-center justify-center text-xl flex-shrink-0">
              💬
            </div>
            <div>
              <p class="font-bold text-texto">WhatsApp</p>
              <a
                href="https://wa.me/1234567890"
                target="_blank"
                rel="noopener noreferrer"
                class="text-texto-suave text-sm mt-1 hover:text-texto transition-colors"
              >
                +52 123 456 7890
              </a>
            </div>
          </div>
        </div>

        <a
          href="https://wa.me/1234567890?text=Hola%20Iris%2C%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20Kineira"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 bg-amarillo hover:bg-amarillo/80 text-texto font-bold px-8 py-4 rounded-full transition-all duration-200 shadow-md hover:shadow-lg mt-10"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.115 1.533 5.838L.057 23.486a.5.5 0 0 0 .609.61l5.757-1.508A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.9a9.9 9.9 0 0 1-5.031-1.369l-.36-.214-3.733.978.995-3.641-.235-.374A9.86 9.86 0 0 1 2.1 12c0-5.468 4.432-9.9 9.9-9.9 5.468 0 9.9 4.432 9.9 9.9 0 5.468-4.432 9.9-9.9 9.9z"/>
          </svg>
          Escríbenos por WhatsApp
        </a>
      </div>

      <!-- Map placeholder -->
      <div class="rounded-3xl overflow-hidden shadow-xl h-96 bg-crema flex items-center justify-center">
        <div class="text-center text-texto-suave">
          <div class="text-6xl mb-4">📍</div>
          <p class="font-semibold">Mapa de ubicación</p>
          <p class="text-sm mt-1">Próximamente</p>
        </div>
      </div>
    </div>
  </div>
</section>
