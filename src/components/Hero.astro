---
---

<section
  id="inicio"
  class="min-h-screen flex items-center relative overflow-hidden pt-24 pb-16"
>
  <!-- Decorative blobs -->
  <div class="absolute top-16 right-0 w-72 h-72 bg-amarillo rounded-full opacity-30 blur-3xl -translate-y-8 translate-x-16 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-64 h-64 bg-azul rounded-full opacity-25 blur-3xl translate-y-8 -translate-x-16 pointer-events-none"></div>
  <div class="absolute top-1/2 left-1/3 w-48 h-48 bg-lavanda rounded-full opacity-20 blur-2xl pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-6 w-full">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <!-- Text -->
      <div class="order-2 md:order-1">
        <span class="inline-block bg-azul/30 text-texto font-semibold text-sm px-4 py-1.5 rounded-full mb-6">
          Fisioterapia pediátrica y neurodesarrollo
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-texto leading-tight mb-6">
          Acompañamos el
          <span class="relative inline-block">
            <span class="relative z-10">desarrollo</span>
            <span class="absolute bottom-1 left-0 right-0 h-3 bg-amarillo/60 -z-0 rounded"></span>
          </span>
          <br />de tu hijo
        </h1>
        <p class="text-texto-suave text-lg leading-relaxed mb-8 max-w-lg">
          En Kineira brindamos atención especializada en fisioterapia pediátrica
          y neurodesarrollo. Acompañamos a cada niño con calidez, profesionalismo
          y un enfoque personalizado.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="https://wa.me/1234567890?text=Hola%20Iris%2C%20me%20gustar%C3%ADa%20agendar%20una%20cita%20en%20Kineira"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-amarillo hover:bg-amarillo/80 text-texto font-bold px-8 py-4 rounded-full transition-all duration-200 shadow-md hover:shadow-lg text-base"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z" />
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.123.558 4.115 1.533 5.838L.057 23.486a.5.5 0 0 0 .609.61l5.757-1.508A11.95 11.95 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.9a9.9 9.9 0 0 1-5.031-1.369l-.36-.214-3.733.978.995-3.641-.235-.374A9.86 9.86 0 0 1 2.1 12c0-5.468 4.432-9.9 9.9-9.9 5.468 0 9.9 4.432 9.9 9.9 0 5.468-4.432 9.9-9.9 9.9z" />
            </svg>
            Agendar cita por WhatsApp
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center gap-2 border-2 border-texto/20 hover:border-texto/40 text-texto font-semibold px-8 py-4 rounded-full transition-all duration-200 text-base"
          >
            Ver servicios
          </a>
        </div>

        <!-- Stats -->
        <div class="flex gap-8 mt-12">
          <div>
            <p class="text-3xl font-extrabold text-texto">+5</p>
            <p class="text-texto-suave text-sm">años de experiencia</p>
          </div>
          <div class="w-px bg-texto/10"></div>
          <div>
            <p class="text-3xl font-extrabold text-texto">100%</p>
            <p class="text-texto-suave text-sm">atención personalizada</p>
          </div>
          <div class="w-px bg-texto/10"></div>
          <div>
            <p class="text-3xl font-extrabold text-texto">❤️</p>
            <p class="text-texto-suave text-sm">familias felices</p>
          </div>
        </div>
      </div>

      <!-- Visual / Logo -->
      <div class="order-1 md:order-2 flex justify-center">
        <div class="relative">
          <!-- Background circle -->
          <div class="w-72 h-72 md:w-96 md:h-96 bg-amarillo/20 rounded-full flex items-center justify-center">
            <div class="w-60 h-60 md:w-80 md:h-80 bg-amarillo/30 rounded-full flex items-center justify-center">
              <img
                src="/assets/logo-cuadrado.png"
                alt="Kineira"
                class="w-48 md:w-64 h-auto drop-shadow-lg"
              />
            </div>
          </div>
          <!-- Floating badges -->
          <div class="absolute -top-4 -right-4 bg-white rounded-2xl shadow-lg p-3 flex items-center gap-2">
            <span class="text-2xl">⭐</span>
            <div>
              <p class="text-xs font-bold text-texto">5.0</p>
              <p class="text-xs text-texto-suave">Calificación</p>
            </div>
          </div>
          <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl shadow-lg p-3">
            <p class="text-xs font-bold text-texto">Especialista en</p>
            <p class="text-xs text-azul font-semibold">Neurodesarrollo 🧠</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
